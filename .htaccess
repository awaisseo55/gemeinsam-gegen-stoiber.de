# 301-Weiterleitung der gesamten Domain gemeinsam-gegen-stoiber.de
# Ziel: https://gebaeudewerke.de/

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^.*$ https://gebaeudewerke.de/ [R=301,L]
</IfModule>

# Fallback, falls mod_rewrite nicht verfuegbar ist
<IfModule !mod_rewrite.c>
  <IfModule mod_alias.c>
    RedirectMatch 301 ^/.*$ https://gebaeudewerke.de/
  </IfModule>
</IfModule>
